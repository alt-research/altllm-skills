{
  "name": "altllm-cli",
  "version": "0.1.0",
  "description": "TS CLI for AltLLM Portal auth, API key management, billing, and payments",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && node --test tests/*.test.mjs && node --import tsx --test test/**/*.test.ts tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alt-research/altllm-skills.git"
  },
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/alt-research/altllm-skills/issues"
  },
  "homepage": "https://github.com/alt-research/altllm-skills#readme",
  "bin": {
    "altllm": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "^14.0.0",
    "viem": "^2.38.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
